{
  "name": "sql-rely",
  "displayName": "SQL Rely",
  "description": "A database testing extension for VS Code using native UI",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing"
  ],
  "extensionDependencies": [
    "ms-mssql.mssql"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "workspaceContains:*.sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sql-rely.runTests",
        "title": "SQL Rely: Run All Tests",
        "category": "Test"
      },
      {
        "command": "sql-rely.installSqlCop",
        "title": "SQL Rely: Install SQLCop Tests",
        "category": "Test"
      },
      {
        "command": "sql-rely.createTest",
        "title": "SQL Rely: Create New Test",
        "category": "Test"
      },
      {
        "command": "sql-rely.installTsqlt",
        "title": "SQL Rely: Install tSQLt Framework",
        "category": "Test"
      },
      {
        "command": "sql-rely.editTest",
        "title": "Edit Test"
      },
      {
        "command": "sql-rely.discoverTests",
        "title": "SQL Rely: Discover Tests Manually",
        "category": "Test"
      }
    ],
    "menus": {
      "testing/item/context": [
        {
          "command": "sql-rely.editTest",
          "when": "testId =~ /\\./",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.0.0"
  }
}
